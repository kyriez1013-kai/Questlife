# Public client configuration only. Copy values from an authorized test project.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Native APIs require an explicit authorized HTTPS origin.
EXPO_PUBLIC_API_ORIGIN=https://YOUR_AUTHORIZED_API_ORIGIN
# Legacy anonymous mirror stays off. Do not enable for account-based V2 testing.
EXPO_PUBLIC_LEGACY_MIRROR_ENABLED=false
# No service-role key, private Quant token or SMTP secret belongs here.
