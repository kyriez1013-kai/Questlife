{
  "expo": {
    "name": "QuestLife",
    "slug": "QuestLife",
    "platforms": ["ios", "web"],
    "scheme": "questlife",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#6C8EFF"
        }
      ],
      "expo-dev-client",
      [
        "expo-calendar",
        {
          "calendarPermission": "QuestLife reads commitments and only edits events you explicitly create with QuestLife."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "QuestLife reads selected sleep, movement and workout observations. They stay on this device unless you explicitly enable health sync and analysis for your account.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "./plugins/with-questlife-ios-entries",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101113"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kyrie.questlife",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "be1ec640-8b5f-4e39-97c1-1480118e993d"
      }
    },
    "owner": "kyirez"
  }
}
