{
  "expo": {
    "name": "QuestLife",
    "slug": "QuestLife",
    "scheme": "questlife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#6C8EFF"
        }
      ],
      "expo-dev-client",
      [
        "expo-calendar",
        {
          "calendarPermission": "QuestLife reads commitments and only edits events you explicitly create with QuestLife."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "QuestLife reads selected sleep, movement and workout observations to compare your own activity over time. Data is stored locally; no health data is sent to analytics.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-connect-permissions",
      "./plugins/with-internal-release-signing",
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101113"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kyrie.questlife",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kyrie.questlife",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101113"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "be1ec640-8b5f-4e39-97c1-1480118e993d"
      }
    },
    "owner": "kyirez"
  }
}
