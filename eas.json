{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "development-simulator": { "extends": "development", "ios": { "simulator": true } },
    "preview": { "distribution": "internal", "credentialsSource": "remote", "autoIncrement": false, "env": { "EXPO_PUBLIC_API_ORIGIN": "https://questlife-v1-release.vercel.app" } },
    "preview-simulator": { "extends": "preview", "developmentClient": false, "ios": { "simulator": true } },
    "production": { "credentialsSource": "remote", "autoIncrement": false }
  }
}
